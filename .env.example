# Application (defaults work without copying this file)
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# MongoDB: required only when connectMongo() is invoked
MONGODB_URI=
MONGODB_DB_NAME=PlanMyMarriage

# Authentication: generate a random secret of at least 32 characters; keep it private
SESSION_SECRET=

# Future Cloudflare R2 capability; not read by this scaffold
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
MAX_IMAGE_BYTES=10485760

# Future CDN configuration
MEDIA_CDN_BASE_URL=https://media.example.com

# Team invitations via Resend (required only when sending)
RESEND_API_KEY=
EMAIL_FROM="Plan My Marriage <invitations@example.com>"
EMAIL_REPLY_TO=

# Authentication uses shared MongoDB fixed-window rate-limit counters.

# Future external vendor provider
VENDOR_PROVIDER=disabled
VENDOR_PROVIDER_KEY=
