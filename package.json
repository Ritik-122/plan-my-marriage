{
  "name": "plan-my-marriage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:auth": "npm run build && playwright test --config playwright.auth.config.ts",
    "db:auth-indexes": "node scripts/auth-indexes.mjs --apply",
    "db:wedding-indexes": "node scripts/wedding-indexes.mjs --apply",
    "db:event-indexes": "node scripts/event-indexes.mjs --apply",
    "db:guest-indexes": "node scripts/guest-indexes.mjs --apply",
    "db:invitation-indexes": "node scripts/invitation-indexes.mjs --apply",
    "db:team-indexes": "node scripts/team-indexes.mjs --apply"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "mongoose": "9.10.2",
    "next": "16.3.6",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
